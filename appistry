#!/usr/bin/env bash
# Resolve symlinks portably (macOS readlink -f requires coreutils)
_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$_SOURCE" ]]; do
    _SOURCE="$(readlink "$_SOURCE")"
    [[ "$_SOURCE" != /* ]] && _SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$_SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$_SOURCE")" && pwd)"

VENV="$SCRIPT_DIR/.venv"
PYTHON="$VENV/bin/python"

# Bootstrap venv if missing
if [[ ! -f "$PYTHON" ]]; then
    echo "Setting up Appistry environment (first run)..."
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q --upgrade pip wheel
    "$VENV/bin/pip" install -q -r "$SCRIPT_DIR/requirements.txt"
fi

exec "$PYTHON" "$SCRIPT_DIR/appistry.py" "$@"
